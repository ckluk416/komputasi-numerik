   "source": [
    "# IV.1 koefisien b_k dari definisi integral, dihitung dengan jumlah Riemann\n",
    "def koef_bk(f, T, k, n=100000):\n",
    "    \"\"\"b_k = (2/T) * integral f(t) sin(2*pi*k*t/T) dt, dihitung dengan jumlah Riemann.\"\"\"\n",
    "    ts = np.linspace(0, T, n, endpoint=False)\n",
    "    dt = T / n\n",
    "    integrand = f(ts) * np.sin(2 * math.pi * k * ts / T)\n",
    "    return (2 / T) * np.sum(integrand) * dt\n",
    "\n",
    "f_persegi = lambda ts: np.where(ts < 0.5, 1.0, -1.0)   # periode T = 1, sama dengan Task III\n",
    "\n",
    "print(f\"{'k':>3} {'b_k numerik':>14} {'b_k analitik':>14} {'Er (%)':>10}\")\n",
    "print(\"-\" * 44)\n",
    "for k in [1, 3, 5, 7, 9]:\n",
    "    bk_num = koef_bk(f_persegi, 1.0, k)\n",
    "    bk_ana = 4 / (math.pi * k)\n",
    "    print(f\"{k:>3} {bk_num:>14.10f} {bk_ana:>14.10f} \"\n",
    "          f\"{abs(bk_num - bk_ana) / bk_ana * 100:>10.6f}\")"
   ]
  },
