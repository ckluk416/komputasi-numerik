    "import math\n",
    "import time\n",
    "\n",
    "def taylor_exp_polos(x, n):\n",
    "    \"\"\"versi Task II: tiap suku hitung ulang pangkat dan faktorial dari nol.\"\"\"\n",
    "    s = 0.0\n",
    "    for k in range(n + 1):\n",
    "        try:\n",
    "            s += x ** k / math.factorial(k)\n",
    "        except OverflowError:\n",
    "            pass          # factorial(k) terlalu besar untuk dikonversi ke float\n",
    "    return s\n",
    "\n",
    "def taylor_exp_cepat(x, n):\n",
    "    \"\"\"suku berikutnya diturunkan dari suku sebelumnya: suku_k = suku_(k-1) * x / k.\"\"\"\n",
    "    total = 1.0\n",
    "    suku = 1.0\n",
    "    for k in range(1, n + 1):\n",
    "        suku = suku * x / k\n",
    "        total += suku\n",
    "    return total\n",
    "\n",
    "x, n, ulang = 5.0, 200, 200\n",
    "\n",
    "t0 = time.perf_counter()\n",
    "for _ in range(ulang):\n",
    "    a = taylor_exp_polos(x, n)\n",
    "t1 = time.perf_counter()\n",
    "for _ in range(ulang):\n",
    "    b = taylor_exp_cepat(x, n)\n",
    "t2 = time.perf_counter()\n",
    "\n",
    "print(f\"versi polos : {(t1 - t0) / ulang * 1e3:.4f} ms per panggilan\")\n",
    "print(f\"versi cepat : {(t2 - t1) / ulang * 1e3:.4f} ms per panggilan\")\n",
    "print(f\"speedup     : {(t1 - t0) / (t2 - t1):.1f}x\")\n",
    "print()\n",
    "print(\"hasil polos :\", repr(a))\n",
    "print(\"hasil cepat :\", repr(b))\n",
    "print(\"math.exp(5) :\", repr(math.exp(x)))\n",
    "print(\"identik ?   \", a == b, \" selisih:\", abs(a - b))"
