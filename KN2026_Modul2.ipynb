   "source": [
    "import math\n",
    "\n",
    "def taylor_cos(x, n):\n",
    "    \"\"\"aproksimasi cos(x) dengan deret Maclaurin sampai suku x^(2n).\"\"\"\n",
    "    s = 0.0\n",
    "    for i in range(n + 1):\n",
    "        s += (-1) ** i * x ** (2 * i) / math.factorial(2 * i)\n",
    "    return s\n",
    "\n",
    "x = 0.3\n",
    "eksak = math.cos(x)\n",
    "\n",
    "print(f\"{'n':>3}{'aproksimasi':>22}{'Ea':>14}{'Er':>14}{'digit benar':>14}\")\n",
    "print(\"-\" * 67)\n",
    "for n in [1, 2, 3, 4]:\n",
    "    ap = taylor_cos(x, n)\n",
    "    Ea = abs(eksak - ap)\n",
    "    Er = Ea / abs(eksak)\n",
    "    digit = -math.log10(Er)\n",
    "    print(f\"{n:>3}{ap:>22.16f}{Ea:>14.3e}{Er:>14.3e}{digit:>14.1f}\")\n",
    "print(\"-\" * 67)\n",
    "print(f\"math.cos(0.3) = {eksak:.16f}\")"
   ]
