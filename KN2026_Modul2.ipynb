   "source": [
    "import numpy as np\n",
    "\n",
    "def fourier_triang(t, N):\n",
    "    \"\"\"rekonstruksi gelombang segitiga (amplitudo 1, periode 2) hingga harmonik ke-N.\"\"\"\n",
    "    t = np.asarray(t, dtype=float)\n",
    "    s = np.zeros_like(t)\n",
    "    for k in range(1, N + 1, 2):\n",
    "        s += 8 / (math.pi ** 2 * k ** 2) * (-1) ** ((k - 1) // 2) * np.sin(math.pi * k * t)\n",
    "    return s\n",
    "\n",
    "t = np.linspace(0, 2, 200001)\n",
    "print(f\"{'N':>6}{'max|f|':>14}{'selisih ke 1.0':>18}\")\n",
    "print(\"-\" * 38)\n",
    "for N in [1, 3, 7, 21, 101]:\n",
    "    m = np.max(fourier_triang(t, N))\n",
    "    print(f\"{N:>6}{m:>14.6f}{m - 1.0:>18.6f}\")\n",
    "print(\"-\" * 38)\n",
    "print(\"suku pertama 8/pi^2 =\", 8 / math.pi ** 2)"
   ]
