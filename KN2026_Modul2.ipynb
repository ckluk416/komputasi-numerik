   "source": [
    "# I.1 deret Maclaurin sin(x) dipotong sampai suku x^(2n+1)\n",
    "import math\n",
    "\n",
    "def taylor_sin(x, n):\n",
    "    \"\"\"aproksimasi sin(x) dengan deret Taylor hingga suku x^(2n+1).\"\"\"\n",
    "    s = 0.0\n",
    "    for i in range(n + 1):\n",
    "        s += (-1) ** i * x ** (2 * i + 1) / math.factorial(2 * i + 1)\n",
    "    return s\n",
    "\n",
    "# uji cepat\n",
    "print(\"taylor_sin(1.0, 4) =\", taylor_sin(1.0, 4))\n",
    "print(\"math.sin(1.0)      =\", math.sin(1.0))"
   ]
  },
