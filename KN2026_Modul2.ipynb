   "source": [
    "# III.1 rekonstruksi gelombang persegi sampai harmonik ke-N\n",
    "import numpy as np\n",
    "import math\n",
    "\n",
    "def fourier_square(t, N):\n",
    "    \"\"\"rekonstruksi gelombang persegi hingga harmonik ke-N (k <= N).\"\"\"\n",
    "    t = np.asarray(t, dtype=float)\n",
    "    s = np.zeros_like(t)\n",
    "    for k in range(1, N + 1, 2):        # hanya harmonik ganjil\n",
    "        s += (4 / math.pi) * np.sin(2 * math.pi * k * t) / k\n",
    "    return s\n",
    "\n",
    "# uji cepat di seperempat periode, seharusnya mendekati +1\n",
    "print(\"fourier_square(0.25, 101) =\", fourier_square(0.25, 101))"
   ]
