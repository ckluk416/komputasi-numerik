   "source": [
    "# II.1 rasio galat antar iterasi deret e^x di x = 1\n",
    "def taylor_exp(x, n):\n",
    "    \"\"\"deret Maclaurin e^x dipotong pada suku ke-n, sama seperti Modul 1.\"\"\"\n",
    "    s = 0.0\n",
    "    for k in range(n + 1):\n",
    "        s += x ** k / math.factorial(k)\n",
    "    return s\n",
    "\n",
    "prev = None\n",
    "for n in range(1, 12):\n",
    "    err = abs(math.exp(1) - taylor_exp(1, n))\n",
    "    ratio = prev / err if prev else float(\"nan\")\n",
    "    print(f\"n={n:2d}  Ea={err:.6e}  rasio={ratio:.3f}\")\n",
    "    prev = err"
   ]
